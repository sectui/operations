{
  "name": "@sectui/operations",
  "version": "0.1.2",
  "description": "CyberChef-like data transformation operations: a TypeScript library and the ops CLI",
  "license": "MIT",
  "author": "Hadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sectui/operations.git"
  },
  "homepage": "https://github.com/sectui/operations#readme",
  "bugs": {
    "url": "https://github.com/sectui/operations/issues"
  },
  "keywords": [
    "cyberchef",
    "encoding",
    "base64",
    "security",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./template": {
      "source": "./src/template.ts",
      "types": "./dist/template.d.ts",
      "default": "./dist/template.js"
    }
  },
  "bin": {
    "ops": "dist/cli.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.ts",
    "test": "node --conditions=source --test 'src/**/*.test.ts'",
    "typecheck": "tsc",
    "docs": "node scripts/gen-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "3.8.3",
    "typescript": "^7"
  },
  "files": [
    "dist",
    "!dist/ops.mjs",
    "src",
    "!src/**/*.test.ts",
    "!src/test",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "yaml": "^2.9.1"
  }
}
